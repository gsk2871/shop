HTTP_ADDRESS=127.0.0.1:8080
DATABASE_DSN=host=127.0.0.1 user=admin password=local-development-only dbname=peptide port=5432 sslmode=disable

UPLOAD_DIR=./storage/uploads
# Set true behind production HTTPS. false is for local HTTP only.
COOKIE_SECURE=false

# Only explicit seed reads this value. Never commit a real seed password.
SEED_ADMIN_PASSWORD=
